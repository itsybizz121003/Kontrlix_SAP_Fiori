<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog title="Create New Request" class="sapUiContentPadding">
        <content>
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
                <f:content>
                    <Label text="Request Type" required="true" />
                    <Select selectedKey="{req>/form/ReqType}">
                        <core:Item key="tea" text="Tea Break" />
                        <core:Item key="lunch" text="Lunch Break" />
                        <core:Item key="permission" text="Permission" />
                        <core:Item key="leave" text="Leave Request" />
                        <core:Item key="other" text="Other" />
                    </Select>

                    <Label text="Reason" required="true" />
                    <TextArea value="{req>/form/Reason}" placeholder="Describe your reason here..." rows="4" />
                </f:content>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button text="Submit" type="Emphasized" press=".onSubmitRequest" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCloseAddRequest" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>