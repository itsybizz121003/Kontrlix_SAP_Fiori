<mvc:View controllerName="ashu.ashu.controller.LiveData"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="liveDataPage" showHeader="false" class="dashboardPage">
        <content>
            <HBox fitContainer="true" class="dashboardLayout">

                <!-- Side Nav -->
                <VBox class="dashSideNav">
                    <HBox class="dashLogoRow" justifyContent="Start" alignItems="Center">
                        <core:Icon src="sap-icon://factory" class="dashLogoIcon" />
                        <Text text="ITSYBIZZ" class="dashLogoText" />
                    </HBox>
                    <List mode="None" class="dashSideList" itemPress=".onSideItemPress">
                        <StandardListItem title="Monitoring-Dashboard" icon="sap-icon://home"               type="Active" />
                        <StandardListItem title="Live Data"            icon="sap-icon://activity-individual" type="Active" selected="true" />
                        <StandardListItem title="Supervisor"           icon="sap-icon://group-2"             type="Active" />
                        <StandardListItem title="Employees"            icon="sap-icon://employee"            type="Active" />
                        <StandardListItem title="Machine History"      icon="sap-icon://history"             type="Active" />
                        <StandardListItem title="Resources"            icon="sap-icon://database"            type="Active" />
                        <StandardListItem title="Machine Info"         icon="sap-icon://settings"            type="Active" />
                        <StandardListItem title="Stoppage Info"        icon="sap-icon://alert"               type="Active" />
                        <StandardListItem title="Requests"             icon="sap-icon://inbox"               type="Active" />
                        <StandardListItem title="Kontrolix-AI"         icon="sap-icon://physical-activity"   type="Active" />
                        <StandardListItem title="My Profile"           icon="sap-icon://customer"            type="Active" />
                    </List>
                    <Button text="Log Out" icon="sap-icon://log" type="Transparent" class="dashLogout" press=".onLogout" />
                </VBox>

                <!-- Main Area -->
                <VBox class="dashMainArea liveMainArea">

                    <!-- Header -->
                    <HBox class="livePageHeader" justifyContent="SpaceBetween" alignItems="Center">
                        <VBox>
                            <Title text="Machine Live Data" level="H2" class="livePageTitle" />
                            <Text text="Real-time status of all connected machines" class="livePageSub" />
                        </VBox>
                        <HBox alignItems="Center" class="liveHeaderRight">
                            <VBox alignItems="End">
                                <Text text="Last Updated" class="liveLastUpdLabel" />
                                <Text text="{live>/lastUpdated}" class="liveLastUpdVal" />
                            </VBox>
                            <ObjectStatus
                                text="{live>/connectionStatusText}"
                                state="{live>/connectionStatusState}"
                                inverted="true" />
                            <Button icon="sap-icon://synchronize" text="Refresh"
                                type="Default" press=".onRefreshLiveData" />
                        </HBox>
                    </HBox>

                    <!-- Summary Strip -->
                    <HBox class="liveSummaryStrip" alignItems="Center">
                        <VBox class="liveSummaryItem">
                            <Text text="TOTAL" class="liveSummaryLabel" />
                            <Text text="{live>/totalMachines}" class="liveSummaryValue" />
                        </VBox>
                        <VBox class="liveSummaryItem">
                            <Text text="RUNNING" class="liveSummaryLabel" />
                            <Text text="{live>/runningCount}" class="liveSummaryValue liveSummaryValue--run" />
                        </VBox>
                        <VBox class="liveSummaryItem">
                            <Text text="IDLE" class="liveSummaryLabel" />
                            <Text text="{live>/idleCount}" class="liveSummaryValue liveSummaryValue--idle" />
                        </VBox>
                        <VBox class="liveSummaryItem">
                            <Text text="STOPPED" class="liveSummaryLabel" />
                            <Text text="{live>/faultCount}" class="liveSummaryValue liveSummaryValue--stop" />
                        </VBox>
                    </HBox>

                    <!-- Filters -->
                    <HBox class="liveFilterBar" alignItems="End" justifyContent="SpaceBetween">
                        <HBox class="dashFilterGroup" alignItems="End">
                            <VBox>
                                <Label text="Brand" class="dashFilterLabel" />
                                <Select width="10rem" items="{live>/brands}" change=".onFilterChange" selectedKey="{live>/filters/plcBrand}">
                                    <core:Item key="{live>key}" text="{live>text}" />
                                </Select>
                            </VBox>
                            <VBox>
                                <Label text="Status" class="dashFilterLabel" />
                                <Select width="10rem" change=".onFilterChange" selectedKey="{live>/filters/machineStatus}">
                                    <core:Item key="all"     text="All Status" />
                                    <core:Item key="RUNNING" text="Running"    />
                                    <core:Item key="IDLE"    text="Idle"       />
                                    <core:Item key="STOPPED" text="Stopped"    />
                                </Select>
                            </VBox>
                            <VBox>
                                <Label text="Date Range" class="dashFilterLabel" />
                                <Select width="10rem" change=".onFilterChange" selectedKey="{live>/filters/dateRange}">
                                    <core:Item key="all"         text="All Time"      />
                                    <core:Item key="today"       text="Today"         />
                                    <core:Item key="yesterday"   text="Yesterday"     />
                                    <core:Item key="thisWeek"    text="This Week"     />
                                    <core:Item key="thisMonth"   text="This Month"    />
                                    <core:Item key="last3Months" text="Last 3 Months" />
                                </Select>
                            </VBox>
                        </HBox>
                        <Button text="Reset" icon="sap-icon://clear-filter" type="Transparent" press=".onResetFilters" class="dashResetBtn" />
                    </HBox>

                    <!-- Section title -->
                    <HBox class="liveSectionHeader" justifyContent="SpaceBetween" alignItems="Center">
                        <Text text="{= 'Machine Data (' + ${live>/totalMachines} + ' machines)'}" class="liveSectionTitle" />
                    </HBox>

                    <!-- ── Cards Grid ── -->
                    <HBox class="liveCardsGrid" items="{live>/machines}" wrap="Wrap">
                        <items>
                            <VBox class="{path: 'live>statusState', formatter: '.formatCardClass'}">

                                <!-- ── CARD HEADER: Device ID + Status Badge ── -->
                                <HBox class="ldCardHead" justifyContent="SpaceBetween" alignItems="Center">
                                    <VBox>
                                        <Text text="{live>deviceId}" class="ldCardDeviceId" />
                                        <Text text="{live>subLine}"  class="ldCardCompany"  />
                                    </VBox>
                                    <ObjectStatus
                                        text="{live>status}"
                                        state="{live>statusState}"
                                        inverted="true"
                                        class="ldCardBadge" />
                                </HBox>

                                <!-- ── MACHINE DETAILS ── -->
                                <VBox class="ldCardDetails">
                                    <Text text="Model: {live>model}"    class="ldCardDetailText" />
                                    <Text text="Part No: {live>partNo}" class="ldCardDetailText" />
                                    <Text text="Material: {live>material}" class="ldCardDetailText" />
                                    <!-- Alarm -->
                                    <HBox alignItems="Center" class="ldCardAlarmRow">
                                        <Text text="Alarm: " class="ldCardDetailLabel" />
                                        <Text text="{live>alarm}"
                                            class="{= ${live>alarm} === 'NONE' ? 'ldAlarmOk' : 'ldAlarmErr'}" />
                                    </HBox>
                                </VBox>

                                <!-- ── START TIME ── -->
                                <VBox class="ldCardStartBox">
                                    <Text text="Start" class="ldCardMiniLabel" />
                                    <Text text="{live>startTime}" class="ldCardStartTime" />
                                </VBox>

                                <!-- ── PRODUCTION + RPM BIG NUMBERS ── -->
                                <HBox class="ldCardBigStats" justifyContent="SpaceBetween">
                                    <VBox class="ldCardBigStat">
                                        <Text text="PRODUCTION COUNT" class="ldCardBigLabel" />
                                        <Text text="{live>productionCount}" class="ldCardBigValue" />
                                    </VBox>
                                    <VBox class="ldCardBigStat">
                                        <Text text="RPM" class="ldCardBigLabel" />
                                        <Text text="{live>rpm}" class="ldCardBigValue" />
                                    </VBox>
                                </HBox>

                                <!-- ── PARAMETERS GRID ── -->
                                <VBox class="ldCardParamSection">
                                    <Text text="PARAMETERS" class="ldCardParamTitle" />
                                    <HBox class="ldCardParamGrid" justifyContent="SpaceBetween">
                                        <VBox class="ldCardParam">
                                            <Text text="TEMPERATURE" class="ldCardParamLabel" />
                                            <Text text="{live>temperature}" class="ldCardParamVal" />
                                        </VBox>
                                        <VBox class="ldCardParam">
                                            <Text text="PRESSURE" class="ldCardParamLabel" />
                                            <Text text="{live>pressure}" class="ldCardParamVal" />
                                        </VBox>
                                        <VBox class="ldCardParam">
                                            <Text text="RPM" class="ldCardParamLabel" />
                                            <Text text="{live>rpm}" class="ldCardParamVal" />
                                        </VBox>
                                    </HBox>
                                    <HBox class="ldCardParamGrid ldCardParamGrid--2" justifyContent="SpaceBetween">
                                        <VBox class="ldCardParam">
                                            <Text text="PRODUCTION" class="ldCardParamLabel" />
                                            <Text text="{live>productionCount}" class="ldCardParamVal" />
                                        </VBox>
                                        <VBox class="ldCardParam">
                                            <Text text="MACHINE STATUS" class="ldCardParamLabel" />
                                            <Text text="{live>status}"
                                                class="{= ${live>statusState} === 'Success' ? 'ldParamRunning' : ${live>statusState} === 'Error' ? 'ldParamStopped' : 'ldParamIdle'}" />
                                        </VBox>
                                        <VBox class="ldCardParam">
                                            <Text text="ALARM" class="ldCardParamLabel" />
                                            <Text text="{live>alarm}"
                                                class="{= ${live>alarm} === 'NONE' ? 'ldAlarmOk' : 'ldAlarmErr'}" />
                                        </VBox>
                                    </HBox>
                                </VBox>

                                <!-- ── FOOTER: Last Sync ── -->
                                <HBox class="ldCardFooter" alignItems="Center">
                                    <Text text="Last Sync" class="ldCardMiniLabel" />
                                    <Text text="{live>timestamp}" class="ldCardFooterTs" />
                                </HBox>

                            </VBox>
                        </items>
                    </HBox>

                </VBox>
            </HBox>
        </content>
    </Page>
</mvc:View>