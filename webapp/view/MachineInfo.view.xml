<mvc:View controllerName="ashu.ashu.controller.MachineInfo"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="machineInfoPage" title="Machine Info" showHeader="false" class="dashboardPage">
        <content>
            <HBox fitContainer="true" class="dashboardLayout">
                <!-- Side navigation -->
                <VBox class="dashSideNav">
                    <HBox class="dashLogoRow" justifyContent="Start" alignItems="Center">
                        <Image src="" width="36px" />
                        <Text text="ITSYBIZZ" class="dashLogoText" />
                    </HBox>
                    <List mode="None" class="dashSideList" itemPress=".onSideItemPress">
                        <StandardListItem title="Monitoring-Dashboard" icon="sap-icon://home" type="Active" />
                        <StandardListItem title="Live Data" icon="sap-icon://activity-individual" type="Active" />
                        <StandardListItem title="Supervisor" icon="sap-icon://group-2" type="Active" />
                        <StandardListItem title="Employees" icon="sap-icon://employee" type="Active" />
                        <StandardListItem title="Machine History" icon="sap-icon://history" type="Active" />
                        <StandardListItem title="Resources" icon="sap-icon://database" type="Active" />
                        <StandardListItem title="Machine Info" icon="sap-icon://settings" type="Active" selected="true" />
                        <StandardListItem title="Stoppage Info" icon="sap-icon://alert" type="Active" />
                        <StandardListItem title="Requests" icon="sap-icon://inbox" type="Active" />
                        <StandardListItem title="Kontrolix-AI" icon="sap-icon://physical-activity" type="Active" />
                        <StandardListItem title="My Profile" icon="sap-icon://customer" type="Active" />
                    </List>
                    <Button text="Log Out" type="Transparent" class="dashLogout" press=".onLogout" />
                </VBox>

                <!-- Main area -->
                <VBox class="dashMainArea">
                    <!-- Top bar -->
                    <HBox class="mhTopBar" justifyContent="SpaceBetween" alignItems="Center">
                        <HBox alignItems="Center">
                            <Avatar displayShape="Circle" class="mhIcon" />
                            <VBox>
                                <Title text="Machine Information" level="H3" />
                                <Text text="View detailed information about your machines" />
                            </VBox>
                        </HBox>
                        <HBox alignItems="Center" class="mhControls">
                            <Select width="10rem" selectedKey="{machineInfo>/selectedMachine}">
                                <items>
                                    <core:Item key="allMachines" text="All Machines" />
                                </items>
                            </Select>
                            <Button text="Refresh" type="Default" press=".onRefresh" />
                        </HBox>
                    </HBox>

                    <!-- Section title with dynamic count -->
                    <Text text="{= 'Machine Information (' + ${machineInfo>/machineTotalCount} + ' machines)'}" class="mhSectionTitle" />

                    <!-- Table bound to machineRows -->
                    <Table class="mhTable" items="{machineInfo>/machineRows}">
                        <columns>
                            <Column><Text text="COMPANY" /></Column>
                            <Column><Text text="MODEL" /></Column>
                            <Column><Text text="DEVICE ID" /></Column>
                            <Column><Text text="PLC STATUS" /></Column>
                            <Column><Text text="MOTOR" /></Column>
                            <Column><Text text="ASSIGNED" /></Column>
                            <Column><Text text="PRODUCT" /></Column>
                            <Column><Text text="PRODUCTION" /></Column>
                            <Column><Text text="LAST SEEN" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <!-- Company -->
                                    <Text text="{machineInfo>company}" />
                                    <!-- Model / machine name -->
                                    <Text text="{machineInfo>machineName}" />
                                    <!-- Device ID -->
                                    <Text text="{machineInfo>deviceId}" />
                                    <!-- PLC status with color state -->
                                    <ObjectStatus
                                        text="{machineInfo>plcStatus}"
                                        state="{machineInfo>plcState}" />
                                    <!-- Motor status with color state -->
                                    <ObjectStatus
                                        text="{machineInfo>motorStatus}"
                                        state="{machineInfo>motorState}" />
                                    <!-- Assigned operator -->
                                    <Text text="{machineInfo>materialcode}" />
                                    <!-- Product -->
                                    <Text text="{machineInfo>product}" />
                                    <!-- Production count -->
                                    <Text text="{machineInfo>production}" />
                                    <!-- Last seen timestamp -->
                                    <Text text="{machineInfo>lastSeen}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                    <!-- Pagination -->
                    <HBox justifyContent="Center" alignItems="Center" class="mhPager">
                        <Button text="Previous" enabled="false" />
                        <Button text="1" type="Emphasized" />
                        <Button text="Next" />
                    </HBox>
                </VBox>
            </HBox>
        </content>
    </Page>
</mvc:View>