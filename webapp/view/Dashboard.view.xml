<mvc:View controllerName="ashu.ashu.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:data="sap.viz.ui5.data">
    <Page id="dashboardPage" title="Machine Monitoring Dashboard" showHeader="false" class="dashboardPage">
        <content>
            <VBox class="dashMainArea">

                <!-- Title row -->
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="dashTitleRow">
                    <VBox>
                        <Title text="Machine Monitoring Dashboard" level="H3" />
                        <Text text="Monitor real-time machine performance and status" />
                    </VBox>
                    <ObjectStatus
                        text="{dash>/connectionStatus}"
                        state="{dash>/connectionState}" />
                </HBox>

                <!-- Filters -->
                <HBox class="dashFilterRow" alignItems="End" justifyContent="SpaceBetween">
                    <HBox class="dashFilterGroup" alignItems="End">
                        <!-- Machine Filter -->
                        <VBox>
                            <Label text="Machine" class="dashFilterLabel" />
                            <Select width="10rem" items="{dash>/brands}" change=".onFilterChange" selectedKey="{dash>/filters/plcBrand}">
                                <core:Item key="{dash>key}" text="{dash>text}" />
                            </Select>
                        </VBox>

                        <!-- Running Status Filter -->
                        <VBox>
                            <Label text="Running Status" class="dashFilterLabel" />
                            <Select width="10rem" change=".onFilterChange" selectedKey="{dash>/filters/machineStatus}">
                                <core:Item key="all" text="All Status" />
                                <core:Item key="RUNNING" text="Running" />
                                <core:Item key="IDLE" text="Ideal" />
                                <core:Item key="STOPPED" text="Stopped" />
                            </Select>
                        </VBox>

                        <!-- Date Range Filter -->
                        <VBox>
                            <Label text="Date Range" class="dashFilterLabel" />
                            <Select width="10rem" change=".onFilterChange" selectedKey="{dash>/filters/dateRange}">
                                <core:Item key="all" text="All Time" />
                                <core:Item key="today" text="Today" />
                                <core:Item key="yesterday" text="Yesterday" />
                                <core:Item key="thisWeek" text="This Week" />
                                <core:Item key="thisMonth" text="This Month" />
                                <core:Item key="last3Months" text="Last 3 Months" />
                            </Select>
                        </VBox>
                    </HBox>

                    <!-- Reset Button -->
                    <Button text="Reset" type="Emphasized" press=".onResetFilters" class="dashFilterResetBtn" />
                </HBox>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- SUMMARY CARDS ROW — image jaisi style                  -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <HBox class="dashSummaryCards" justifyContent="SpaceBetween">

                    <!-- Card 1: Total Production — blue -->
                    <VBox class="dashSumCard dashSumCard--blue">
                        <Text text="Total Production" class="dashSumCardTitle" />
                        <Text text="{dash>/totalProduction}" class="dashSumCardValue" />
                        <HBox alignItems="Center" class="dashSumCardSub">
                            <core:Icon src="sap-icon://arrow-top" color="#1a73e8" />
                            <Text text="All Records" class="dashSumCardSubText" />
                        </HBox>
                    </VBox>

                    <!-- Card 2: Stop Time — yellow -->
                    <VBox class="dashSumCard dashSumCard--yellow">
                        <Text text="Ideal Time (Idle)" class="dashSumCardTitle" />
                        <Text text="{dash>/stopTime}" class="dashSumCardValue" />
                        <HBox alignItems="Center" class="dashSumCardSub">
                            <core:Icon src="sap-icon://arrow-bottom" color="#e65100" />
                            <Text text="Stoppage Time" class="dashSumCardSubText" />
                        </HBox>
                    </VBox>

                    <!-- Card 3: Total Machines — purple -->
                    <VBox class="dashSumCard dashSumCard--purple">
                        <Text text="Total Machines" class="dashSumCardTitle" />
                        <Text text="{dash>/totalMachines}" class="dashSumCardValue" />
                        <HBox alignItems="Center" class="dashSumCardSub">
                            <core:Icon src="sap-icon://arrow-top" color="#6a1b9a" />
                            <Text text="Active Devices" class="dashSumCardSubText" />
                        </HBox>
                    </VBox>

                    <!-- Card 4: Unique Parameters — orange -->
                    <VBox class="dashSumCard dashSumCard--orange">
                        <Text text="Total Unique Parameters" class="dashSumCardTitle" />
                        <Text text="{dash>/uniqueParameters}" class="dashSumCardValue" />
                        <HBox alignItems="Center" class="dashSumCardSub">
                            <core:Icon src="sap-icon://arrow-top" color="#e65100" />
                            <Text text="Unique Parameters" class="dashSumCardSubText" />
                        </HBox>
                    </VBox>

                    <!-- Card 5: Running — green -->
                    <VBox class="dashSumCard dashSumCard--green">
                        <Text text="Running" class="dashSumCardTitle" />
                        <Text text="{dash>/runningCount}" class="dashSumCardValue" />
                        <HBox alignItems="Center" class="dashSumCardSub">
                            <core:Icon src="sap-icon://arrow-top" color="#2e7d32" />
                            <Text text="Active Machines" class="dashSumCardSubText" />
                        </HBox>
                    </VBox>

                    <!-- Card 6: Stopped — red -->
                    <VBox class="dashSumCard dashSumCard--red">
                        <Text text="Stopped" class="dashSumCardTitle" />
                        <Text text="{dash>/stoppedCount}" class="dashSumCardValue" />
                        <HBox alignItems="Center" class="dashSumCardSub">
                            <core:Icon src="sap-icon://arrow-bottom" color="#c62828" />
                            <Text text="Stopped Machines" class="dashSumCardSubText" />
                        </HBox>
                    </VBox>

                </HBox>
                <!-- ═══════════════════════════════════════════════════════ -->

                <!-- Machine Time Summary -->
                <HBox class="dashSectionCard" justifyContent="SpaceBetween" alignItems="Center">
                    <VBox class="mtsDonutWrapper">
                        <Text text="Machine Time Summary" class="dashSectionTitle" />
                        <viz:VizFrame
                            id="timeSummaryChart"
                            vizType="donut"
                            width="380px"
                            height="350px"
                            uiConfig="{applicationSet:'fiori'}">
                            <viz:dataset>
                                <data:FlattenedDataset data="{dash>/timeChartData}">
                                    <data:dimensions>
                                        <data:DimensionDefinition name="Type" value="{dash>type}" />
                                    </data:dimensions>
                                    <data:measures>
                                        <data:MeasureDefinition name="Minutes" value="{dash>minutes}" />
                                    </data:measures>
                                </data:FlattenedDataset>
                            </viz:dataset>
                            <viz:feeds>
                                <feeds:FeedItem uid="size"  type="Measure"    values="Minutes" />
                                <feeds:FeedItem uid="color" type="Dimension"  values="Type" />
                            </viz:feeds>
                        </viz:VizFrame>
                    </VBox>
                    <VBox class="mtsSideCards">
                        <VBox class="mtsSideCard mtsRun">
                            <Text text="RUN TIME"  class="dashCardTitle" />
                            <Text text="{dash>/runTime}"   class="dashCardValue" />
                            <Text text="{dash>/runPercent}" class="dashCardSub" />
                        </VBox>
                        <VBox class="mtsSideCard mtsStop">
                            <Text text="STOP TIME" class="dashCardTitle" />
                            <Text text="{dash>/stopTime}"   class="dashCardValue" />
                            <Text text="{dash>/stopPercent}" class="dashCardSub" />
                        </VBox>
                    </VBox>
                </HBox>

                <!-- Downtime Analysis Overview -->
                <VBox class="dashSectionCard">
                    <Text text="Downtime Analysis Overview" class="dashSectionTitle" />
                    <HBox class="daoRow">
                        <VBox class="daoChartCard">
                            <Text text="Downtime Distribution by Case" class="daoTitle" />
                            <ObjectStatus text="LIVE" state="Success" />
                            <VBox class="daoDonutPlaceholder">
                                <Text text="Scheduled Service" />
                            </VBox>
                        </VBox>
                        <VBox class="daoChartCard">
                            <Text text="Downtime by Machine / Station" class="daoTitle" />
                            <ObjectStatus text="LIVE" state="Success" />
                            <VBox class="daoEmpty">
                                <Text text="No Data" />
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Machine Performance & RPM Charts -->
                <HBox class="dashSectionCard">
                    <VBox width="50%" class="mpChartCard">
                        <Text text="Machine Performance" class="dashSectionTitle" />
                        <viz:VizFrame
                            id="productionChart"
                            vizType="dual_column"
                            width="100%"
                            height="300px"
                            uiConfig="{applicationSet:'fiori'}">
                            <viz:dataset>
                                <data:FlattenedDataset data="{dash>/chartData}">
                                    <data:dimensions>
                                        <data:DimensionDefinition name="Machine" value="{dash>label}" />
                                    </data:dimensions>
                                    <data:measures>
                                        <data:MeasureDefinition name="Production"       value="{dash>production}" />
                                        <data:MeasureDefinition name="Temperature (°C)" value="{dash>temperature}" />
                                    </data:measures>
                                </data:FlattenedDataset>
                            </viz:dataset>
                            <viz:feeds>
                                <feeds:FeedItem uid="valueAxis"    type="Measure"   values="Production" />
                                <feeds:FeedItem uid="valueAxis2"   type="Measure"   values="Temperature (°C)" />
                                <feeds:FeedItem uid="categoryAxis" type="Dimension" values="Machine" />
                            </viz:feeds>
                        </viz:VizFrame>
                    </VBox>

                    <VBox width="50%" class="mpChartCard">
                        <Text text="RPM &amp; Pressure" class="dashSectionTitle" />
                        <viz:VizFrame
                            id="rpmChart"
                            vizType="dual_column"
                            width="100%"
                            height="300px"
                            uiConfig="{applicationSet:'fiori'}">
                            <viz:dataset>
                                <data:FlattenedDataset data="{dash>/chartData}">
                                    <data:dimensions>
                                        <data:DimensionDefinition name="Machine" value="{dash>label}" />
                                    </data:dimensions>
                                    <data:measures>
                                        <data:MeasureDefinition name="RPM"           value="{dash>rpm}" />
                                        <data:MeasureDefinition name="Pressure (bar)" value="{dash>pressure}" />
                                    </data:measures>
                                </data:FlattenedDataset>
                            </viz:dataset>
                            <viz:feeds>
                                <feeds:FeedItem uid="valueAxis"    type="Measure"   values="RPM" />
                                <feeds:FeedItem uid="valueAxis2"   type="Measure"   values="Pressure (bar)" />
                                <feeds:FeedItem uid="categoryAxis" type="Dimension" values="Machine" />
                            </viz:feeds>
                        </viz:VizFrame>
                    </VBox>
                </HBox>

                <!-- Machine History Status Changes -->
                <VBox class="dashSectionCard">
                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                        <Text text="Machine History (Status Changes)" class="dashSectionTitle" />
                        <Button text="View All" type="Emphasized" />
                    </HBox>
                    <Table items="{dash>/historyRows}" class="mhTable" noDataText="No history found">
                        <columns>
                            <Column><Text text="TIMESTAMP" /></Column>
                            <Column><Text text="MACHINE"   /></Column>
                            <Column><Text text="PREVIOUS"  /></Column>
                            <Column><Text text="CURRENT"   /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{dash>timestamp}" />
                                    <Text text="{dash>machine}"   />
                                    <ObjectStatus text="{dash>previous}" state="None" />
                                    <ObjectStatus text="{dash>current}"  state="{dash>currentState}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>