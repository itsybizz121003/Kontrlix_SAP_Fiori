<mvc:View controllerName="ashu.ashu.controller.StoppageInfo"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="stoppageInfoPage" title="Machine Stoppage Information" showHeader="false" class="dashboardPage">
        <content>
            <HBox fitContainer="true" class="dashboardLayout">

                <!-- Side navigation -->
                <VBox class="dashSideNav">
                    <HBox class="dashLogoRow" justifyContent="Start" alignItems="Center">
                        <Image src="" width="36px" />
                        <Text text="ITSYBIZZ" class="dashLogoText" />
                    </HBox>
                    <List mode="None" class="dashSideList" itemPress=".onSideItemPress">
                        <StandardListItem title="Monitoring-Dashboard" icon="sap-icon://home"              type="Active" />
                        <StandardListItem title="Live Data"            icon="sap-icon://activity-individual" type="Active" />
                        <StandardListItem title="Supervisor"           icon="sap-icon://group-2"            type="Active" />
                        <StandardListItem title="Employees"            icon="sap-icon://employee"           type="Active" />
                        <StandardListItem title="Machine History"      icon="sap-icon://history"            type="Active" />
                        <StandardListItem title="Resources"            icon="sap-icon://database"           type="Active" />
                        <StandardListItem title="Machine Info"         icon="sap-icon://settings"           type="Active" />
                        <StandardListItem title="Stoppage Info"        icon="sap-icon://alert"              type="Active" selected="true" />
                        <StandardListItem title="Requests"             icon="sap-icon://inbox"              type="Active" />
                        <StandardListItem title="Kontrolix-AI"         icon="sap-icon://physical-activity"  type="Active" />
                        <StandardListItem title="My Profile"           icon="sap-icon://customer"           type="Active" />
                    </List>
                    <Button text="Log Out" type="Transparent" class="dashLogout" press=".onLogout" />
                </VBox>

                <!-- Main area -->
                <VBox class="dashMainArea">

                    <!-- Top bar -->
                    <HBox class="mhTopBar" justifyContent="SpaceBetween" alignItems="Center">
                        <HBox alignItems="Center">
                            <Avatar displayShape="Circle" class="mhIcon" />
                            <VBox>
                                <Title text="Machine Stoppage Information" level="H3" />
                                <Text text="Track machine stoppages, durations, and downtime analysis" />
                            </VBox>
                        </HBox>
                        <HBox alignItems="Center" class="mhControls">
                            <Select width="8rem" selectedKey="{stoppage>/selectedTime}">
                                <items><core:Item key="allTime" text="All Time" /></items>
                            </Select>
                            <Select width="10rem" selectedKey="{stoppage>/selectedMachine}">
                                <items><core:Item key="allMachines" text="All Machines" /></items>
                            </Select>
                            <Button text="Refresh" type="Default" press=".onRefresh" />
                        </HBox>
                    </HBox>

                    <!-- ═══════════════════════════════════════════════════ -->
                    <!-- SUMMARY CARDS — full width, one row, 3 cards       -->
                    <!-- ═══════════════════════════════════════════════════ -->
                    <HBox class="stpCardsRow" justifyContent="SpaceBetween">

                        <!-- Card 1: Run Time — Green -->
                        <VBox class="stpCard stpCard--green">
                            <HBox justifyContent="SpaceBetween" alignItems="Center">
                                <Text text="RUN TIME" class="stpCardLabel" />
                                <core:Icon src="sap-icon://activity-individual" class="stpCardIcon stpCardIcon--green" />
                            </HBox>
                            <Text text="{stoppage>/runTime}" class="stpCardValue stpCardValue--green" />
                            <HBox alignItems="Center" class="stpCardFooter">
                                <core:Icon src="sap-icon://arrow-top" color="#16a34a" />
                                <Text text="Total machine run duration" class="stpCardSubText" />
                            </HBox>
                        </VBox>

                        <!-- Card 2: Ideal Time — Blue -->
                        <VBox class="stpCard stpCard--blue">
                            <HBox justifyContent="SpaceBetween" alignItems="Center">
                                <Text text="IDEAL TIME" class="stpCardLabel" />
                                <core:Icon src="sap-icon://time-overtime" class="stpCardIcon stpCardIcon--blue" />
                            </HBox>
                            <Text text="{stoppage>/idealTime}" class="stpCardValue stpCardValue--blue" />
                            <HBox alignItems="Center" class="stpCardFooter">
                                <core:Icon src="sap-icon://arrow-top" color="#1d4ed8" />
                                <Text text="Expected productive time" class="stpCardSubText" />
                            </HBox>
                        </VBox>

                        <!-- Card 3: Stop Time — Red -->
                        <VBox class="stpCard stpCard--red">
                            <HBox justifyContent="SpaceBetween" alignItems="Center">
                                <Text text="STOP TIME" class="stpCardLabel" />
                                <core:Icon src="sap-icon://alert" class="stpCardIcon stpCardIcon--red" />
                            </HBox>
                            <Text text="{stoppage>/stopTime}" class="stpCardValue stpCardValue--red" />
                            <HBox alignItems="Center" class="stpCardFooter">
                                <core:Icon src="sap-icon://arrow-bottom" color="#dc2626" />
                                <Text text="Total downtime duration" class="stpCardSubText" />
                            </HBox>
                        </VBox>

                    </HBox>
                    <!-- ═══════════════════════════════════════════════════ -->

                    <!-- Events table -->
                    <Text text="{= 'Stoppage Events (' + ${stoppage>/stoppageTotalCount} + ' total)'}" class="mhSectionTitle" />
                    <Table class="mhTable" items="{stoppage>/stoppageRows}">
                        <columns>
                            <Column><Text text="MACHINE"    /></Column>
                            <Column><Text text="DEVICE ID"  /></Column>
                            <Column><Text text="STARTED AT" /></Column>
                            <Column><Text text="STOPPED AT" /></Column>
                            <Column><Text text="RUN TIME"   /></Column>
                            <Column><Text text="IDEAL TIME" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <VBox>
                                        <Text text="{stoppage>company}"     />
                                        <Text text="{stoppage>machineName}" />
                                    </VBox>
                                    <Text text="{stoppage>deviceId}"  />
                                    <Text text="{stoppage>startedAt}" />
                                    <Text text="{stoppage>stoppedAt}" />
                                    <Text text="{stoppage>runTime}"   />
                                    <Text text="{stoppage>idealTime}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                    <!-- Pager -->
                    <HBox justifyContent="Center" alignItems="Center" class="mhPager">
                        <Button text="Previous" enabled="false" />
                        <Button text="1" type="Emphasized" />
                        <Button text="Next" />
                    </HBox>

                </VBox>
            </HBox>
        </content>
    </Page>
</mvc:View>